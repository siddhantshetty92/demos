{
  "openapi": "3.1.0",
  "info": {
    "title": "Acme Scheduling Scheduling API",
    "version": "1.4.0"
  },
  "paths": {
    "/v1/shifts": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Shift"
                }
              }
            }
          }
        }
      },
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShiftInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Shift"
                }
              }
            }
          }
        }
      }
    },
    "/v1/schedules/{id}/publish": {
      "post": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/schedules/{id}/publish": {
      "post": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Shift": {
        "type": "object",
        "required": [
          "id",
          "start",
          "end",
          "assignee"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "assignee": {
            "type": "string"
          }
        }
      },
      "ShiftInput": {
        "type": "object",
        "required": [
          "start",
          "end",
          "assignee"
        ],
        "properties": {
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "assignee": {
            "type": "string"
          }
        }
      },
      "ShiftV2": {
        "type": "object",
        "required": [
          "id",
          "assignees"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "assignees": {
            "type": "array"
          }
        }
      }
    }
  }
}